{
  "realm": "grid-tenant-1-idp",
  "keycloakVersion": "26.8.0",
  "accessTokenLifespan": 21600,
  "ssoSessionIdleTimeout": 21600,
  "enabled": true,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "saas-broker",
      "name": "SaaS broker for Grid Tenant 1",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${GRID_TENANT_1_BROKER_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${KEYCLOAK_PUBLIC_URL}/realms/saas/broker/grid-tenant-1/endpoint"
      ],
      "attributes": {
        "post.logout.redirect.uris": "${KEYCLOAK_PUBLIC_URL}/realms/saas/broker/grid-tenant-1/endpoint/logout_response"
      },
      "protocolMappers": [
        {
          "name": "MaaS tenant groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "maas_groups",
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "false"
          }
        },
        {
          "name": "MaaS organization transport",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "maas_orgs_json",
            "claim.name": "https://redhat\\.com/maas/orgs",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "false"
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "id": "3e4c96cc-b3b4-48d0-bab6-cb67fffc6cfb",
        "name": "grid-tenant-1-idp-signing",
        "providerId": "java-keystore",
        "subComponents": {},
        "config": {
          "kid": ["3e4c96cc-b3b4-48d0-bab6-cb67fffc6cfb"],
          "priority": ["1000"],
          "enabled": ["true"],
          "active": ["true"],
          "algorithm": ["RS256"],
          "keyUse": ["SIG"],
          "keystore": ["/opt/keycloak/data/grid-tenant-1-idp/keystore.jks"],
          "keystoreType": ["JKS"],
          "keystorePassword": ["${KEYCLOAK_SIGNING_KEYSTORE_PASSWORD}"],
          "keyAlias": ["grid-tenant-1-idp-signing"],
          "keyPassword": ["${KEYCLOAK_SIGNING_KEYSTORE_PASSWORD}"]
        }
      }
    ],
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "id": "b5919e8a-046d-47e7-8a2c-f30f5ff12001",
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "config-pieces-count": ["1"],
          "config-piece-0": ["{\"unmanagedAttributePolicy\":\"ADMIN_EDIT\"}"]
        }
      }
    ]
  },
  "groups": [
    {
      "name": "42c3e46f-2477-44d7-a85b-d3b43f6b31fa",
      "subGroups": [
        { "name": "ai-grid-admins" },
        { "name": "ai-grid-users" }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@grid-tenant-1.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Tenant",
      "groups": [
        "/42c3e46f-2477-44d7-a85b-d3b43f6b31fa/ai-grid-admins",
        "/42c3e46f-2477-44d7-a85b-d3b43f6b31fa/ai-grid-users"
      ],
      "attributes": {
        "maas_groups": [
          "42c3e46f-2477-44d7-a85b-d3b43f6b31fa/ai-grid-admins",
          "42c3e46f-2477-44d7-a85b-d3b43f6b31fa/ai-grid-users"
        ],
        "maas_orgs_json": [
          "[{\"organization_id\":\"42c3e46f-2477-44d7-a85b-d3b43f6b31fa\",\"roles\":[\"admins\"]}]"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${GRID_TENANT_1_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
